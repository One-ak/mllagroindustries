# Use a unique value of at least 14 characters. Never commit your real secret.
ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional. The default is the protected local path .data/vansh_leads.db.
DB_PATH=/home/your-user/mllagroindustries-data/vansh_leads.db

# Optional comma-separated origins for local preview servers.
ALLOWED_ORIGINS=http://localhost:4177,http://127.0.0.1:4177

# Set to 1 only when the app is behind exactly one trusted reverse proxy.
TRUST_PROXY=0
